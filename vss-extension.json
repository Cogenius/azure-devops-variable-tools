{
  "manifestVersion": 1,
  "id": "cogenius-variable-tools",
  "name": "Cogenius Variable tools for Azure DevOps",
  "version": "1.0.0",
  "public": false,
  "publisher": "Cogenius",
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services.Cloud"
    },
    {
      "id": "Microsoft.TeamFoundation.Server",
      "version": "[19.0,)"
    }
  ],
  "description": "Save pipeline variables (e.g. GitVersion and Build variables) to JSON in one pipeline/stage and load them again in another. Runs on Windows, Linux and macOS agents.",
  "categories": [
    "Azure Pipelines"
  ],
  "tags": [
    "release",
    "build",
    "variable",
    "variables",
    "gitversion",
    "linux",
    "cross-platform"
  ],
  "links": {
    "home": {
      "uri": "https://github.com/Cogenius/azure-devops-variable-tools"
    },
    "learn": {
      "uri": "https://github.com/Cogenius/azure-devops-variable-tools#readme"
    },
    "support": {
      "uri": "https://github.com/Cogenius/azure-devops-variable-tools/issues"
    },
    "license": {
      "uri": "https://github.com/Cogenius/azure-devops-variable-tools/blob/master/LICENSE.txt"
    }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/Cogenius/azure-devops-variable-tools"
  },
  "icons": {
    "default": "images/extension-icon.png"
  },
  "branding": {
    "color": "#1C3272",
    "theme": "dark"
  },
  "content": {
    "details": {
      "path": "README.md"
    },
    "license": {
      "path": "LICENSE.txt"
    }
  },
  "files": [
    {
      "path": "tasks/CogeniusVariableSave"
    },
    {
      "path": "tasks/CogeniusVariableLoad"
    }
  ],
  "contributions": [
    {
      "id": "cogenius-variable-save-task",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "tasks/CogeniusVariableSave"
      }
    },
    {
      "id": "cogenius-variable-load-task",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "tasks/CogeniusVariableLoad"
      }
    }
  ]
}
